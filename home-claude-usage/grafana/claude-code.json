    {
      "type": "stat",
      "title": "Active time",
      "description": "Time you spent typing plus time Claude spent working, for sessions active in this period.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max_over_time(claude_code_active_time_seconds_total[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "#d97757"
          }
        },
        "overrides": []
      },
      "id": 7
    },
    {
      "type": "stat",
      "title": "Lines changed",
      "description": "Lines added and removed by Claude's edits, for sessions active in this period.",
      "gridPos": {
        "x": 21,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(max_over_time({__name__=~\"claude_code_lines_of_code.*\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
